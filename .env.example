# Local secrets — copy to `.env` and fill QMTOOL_PG_PASSWORD (never commit `.env`).

# =============================================================================
# Runtime / lab PostgreSQL (Usermanagement AP-028)
# Used by conftest to build QMTOOL_PG_DSN for optional local live tests.
# Do NOT use these values for J04-M0 destructive fixtures (QMTOOL_PG_TEST_*).
# =============================================================================

QMTOOL_PG_HOST=192.168.0.4
QMTOOL_PG_PORT=5432
QMTOOL_PG_DATABASE=qmtool_test
QMTOOL_PG_USER=qmtool
QMTOOL_PG_PASSWORD=

# Optional full runtime/lab DSN (overrides parts when set):
# QMTOOL_PG_DSN=postgresql://qmtool:<password>@192.168.0.4:5432/qmtool_test

# =============================================================================
# J04-M0 isolated destructive test cluster (disposable instance)
# Separate host/port/DB/credentials from runtime/lab above. Required only for
# `pytest -m postgres` live fixtures after guard opt-in (never commit secrets).
# PostgreSQL major must be >= 16; pin the exact major with EXPECTED_MAJOR.
# Do NOT store QMTOOL_PG_TEST_RESET here — scripts/run_postgres_live_tests.py
# injects the opt-in only into the pytest child after a read-only preflight.
# See tests/postgres/README.md
# =============================================================================

# QMTOOL_PG_TEST_ADMIN_DSN=postgresql://<admin>:<password>@<host>:<port>/qmtool_j04_destructive_test
# QMTOOL_PG_TEST_EXPECTED_DATABASE=qmtool_j04_destructive_test
# QMTOOL_PG_TEST_EXPECTED_MAJOR=18
# QMTOOL_PG_REQUIRED=1

# Optional one-time first admin (only when the user table is empty; never admin/admin):
# QMTOOL_BOOTSTRAP_ADMIN_USERNAME=
# QMTOOL_BOOTSTRAP_ADMIN_PASSWORD=

# Backend requires an explicit license mode (no implicit "dev"):
# QMTOOL_LICENSE_MODE=dev
# QMTOOL_RUNTIME_PROFILE=production  # forbids LICENSE_MODE=dev|auto

# =============================================================================
# Backend service host (OPS00-A; uninstalled local process)
# Slot 1 vs Slot 2 PostgreSQL comments above are unchanged.
# =============================================================================

# Runtime home for logs, license material, certs, blobstore, backups (no secrets here):
# QMTOOL_HOME=C:\ProgramData\QMTool

# Bind address for `python -m src.backend` (non-production defaults: loopback HTTP):
# QMTOOL_BIND_HOST=127.0.0.1
# QMTOOL_BIND_PORT=8000

# Production profile requires valid PEM TLS files and serves HTTPS (OPS00-B):
# QMTOOL_TLS_CERT_FILE=C:\ProgramData\QMTool\certs\server.pem
# QMTOOL_TLS_KEY_FILE=C:\ProgramData\QMTool\certs\server-key.pem

# Optional same-origin static fixture (built webclient dist or test fixture directory):
# QMTOOL_WEBCLIENT_DIST=C:\ProgramData\QMTool\webclient\dist
