# Local secrets — copy to `.env` and fill QMTOOL_PG_PASSWORD (never commit `.env`).
# Live PostgreSQL tests read QMTOOL_PG_DSN, or build it from the parts below.

# Lab / developer test server (Usermanagement AP-028)
QMTOOL_PG_HOST=192.168.0.4
QMTOOL_PG_PORT=5432
QMTOOL_PG_DATABASE=qmtool_test
QMTOOL_PG_USER=qmtool
QMTOOL_PG_PASSWORD=

# Optional full DSN (overrides parts when set):
# QMTOOL_PG_DSN=postgresql://qmtool:<password>@192.168.0.4:5432/qmtool_test

# Set to 1 only when a reachable DSN is required (CI / explicit local gate):
# QMTOOL_PG_REQUIRED=0
