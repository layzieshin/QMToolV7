{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \".cursor/hooks/session-start.ps1\"",
        "timeout": 10
      }
    ],
    "preToolUse": [
      {
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \".cursor/hooks/subagent-start.ps1\"; exit $LASTEXITCODE",
        "matcher": "^Task$",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "subagentStart": [
      {
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \".cursor/hooks/subagent-start.ps1\"; exit $LASTEXITCODE",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "beforeShellExecution": [
      {
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \".cursor/hooks/git-guard.ps1\"",
        "matcher": "(?:[gG][iI][tT]|[gG][hH])",
        "timeout": 30,
        "failClosed": true
      }
    ],
    "stop": [
      {
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \".cursor/hooks/workflow-watchdog.ps1\"",
        "timeout": 10,
        "loop_limit": 8
      }
    ]
  }
}
