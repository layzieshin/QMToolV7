{
  "version": 3,
  "profile": "cursor-first",
  "defaults": {
    "max_checkpoint_reworks": 2,
    "max_final_audit_reworks": 2,
    "max_escalation_reviews": 1,
    "max_reviewer_verification_passes": 1,
    "max_parallel_workers": 3,
    "stop_hook_loop_limit": 8,
    "local_only": true,
    "architecture_change_requires_human": true,
    "auto_merge_after_all_gates": true,
    "max_technical_recovery_batches": 2
  },
  "planning_quality": {
    "enabled": true,
    "automatic_challenge_risk_levels": [
      "HIGH"
    ],
    "max_plan_challenge_rounds": 1,
    "max_scope_correction_rounds": 1,
    "require_requirement_traceability": true,
    "require_risk_to_evidence": true,
    "require_integration_scenario_for_interacting_checkpoints": true
  },
  "external_review": {
    "enabled": true,
    "provider": "github-codex",
    "required_when_available": true,
    "unavailability_blocks_merge": false,
    "max_review_rounds": 2,
    "max_rework_batches": 2,
    "max_review_requests_per_round": 1,
    "max_triage_passes_per_round": 1,
    "wait_seconds": 300,
    "poll_interval_seconds": 30,
    "statuses": [
      "NOT_REQUESTED",
      "PENDING",
      "PASS",
      "FINDINGS",
      "STALE",
      "BOUNDED_COMPLETE",
      "UNAVAILABLE",
      "LIMIT_REACHED",
      "DISABLED"
    ],
    "review_author_logins": [
      "chatgpt-codex-connector",
      "chatgpt-codex-connector[bot]"
    ]
  },
  "workflow_contract": {
    "statuses": [
      "IDLE",
      "RUNNING",
      "BLOCKED_HUMAN",
      "DONE"
    ],
    "phases": [
      "PLAN",
      "IMPLEMENT",
      "REVIEW",
      "REWORK",
      "ESCALATION_REVIEW",
      "CHECKPOINT_GIT",
      "FULL_REGRESSION",
      "FINAL_AUDIT",
      "FINAL_GIT",
      "NEXT_PACKAGE"
    ]
  },
  "roles": {
    "roadmap-architect": {
      "model": "grok-4.7-high",
      "purpose": "High-quality roadmap and architecture planning plus the fresh final audit of a complete work package.",
      "allowed_responsibility": [
        "analyze roadmap dependencies and risks",
        "prepare vertical work packages and checkpoints",
        "write architecture change proposals in the existing AP/ADR structure",
        "perform the final work-package audit",
        "perform the final work-package audit for non-critical packages"
      ],
      "forbidden_responsibility": [
        "modify product source code",
        "repair implementation findings",
        "commit, push, create pull requests, or merge",
        "silently change established architecture",
        "perform critical-package final audit when external Codex is required"
      ]
    },
    "repo-explorer": {
      "model": "composer-2.5[]",
      "purpose": "Cost-efficient, read-only, fact-oriented exploration of larger repository areas.",
      "allowed_responsibility": [
        "locate owners, dependencies, patterns, tests, and boundaries",
        "report concrete paths and evidence",
        "identify uncertainty without resolving architecture choices"
      ],
      "forbidden_responsibility": [
        "edit files",
        "make architecture or product decisions",
        "grant checkpoint PASS",
        "perform Git write operations"
      ]
    },
    "implementer": {
      "model": "composer-2.5[]",
      "purpose": "Implement exactly one approved checkpoint, including its tests and targeted verification.",
      "allowed_responsibility": [
        "edit only the current checkpoint scope",
        "add or update required tests",
        "run targeted verification",
        "perform a concrete reviewer-assigned rework",
        "report a required correction to an incomplete allowlist before editing"
      ],
      "forbidden_responsibility": [
        "expand scope or change architecture",
        "grant PASS to its own work",
        "commit, push, create pull requests, or merge",
        "start another checkpoint"
      ]
    },
    "checkpoint-reviewer": {
      "model": "grok-4.7-high",
      "purpose": "Independently verify one checkpoint, its real use case, acceptance criteria, architecture, scope, and tests.",
      "allowed_responsibility": [
        "inspect the original checkpoint and actual diff",
        "rerun relevant tests independently",
        "return evidence per acceptance criterion",
        "issue a minimal rework instruction on FAIL"
      ],
      "forbidden_responsibility": [
        "edit source code or tests",
        "repair findings",
        "commit, push, create pull requests, or merge",
        "approve based only on the implementer report"
      ]
    },
    "escalation-reviewer": {
      "model": "composer-2.5[]",
      "purpose": "Read-only EXTERNAL-CODEX-HANDOFF validator after exhausted normal reworks. Returns only HANDOFF_READY or HANDOFF_INVALID.",
      "allowed_responsibility": [
        "validate external Codex handoff structure, staleness, and hash binding",
        "return HANDOFF_READY or HANDOFF_INVALID with evidence gaps"
      ],
      "forbidden_responsibility": [
        "edit source code or tests",
        "grant PASS or FAIL verdicts",
        "issue findings or merge approval",
        "perform further rework",
        "commit, push, create pull requests, or merge",
        "substitute for external Codex review"
      ]
    },
    "git-steward": {
      "model": "composer-2.5[]",
      "purpose": "Perform only gated Git and GitHub routine operations for the active work package.",
      "allowed_responsibility": [
        "inspect status and exact staged paths",
        "create checkpoint commits",
        "push the work-package branch",
        "create or update the final pull request",
        "inspect checks and external review state",
        "request one configured GitHub Codex review round when instructed",
        "merge after all final gates"
      ],
      "forbidden_responsibility": [
        "modify product or test code",
        "decide or repair external review findings",
        "use Codex to modify source code",
        "resolve fachliche merge conflicts",
        "bypass branch protection or required checks",
        "force-push, rebase, or push to the base branch"
      ]
    },
    "plan-challenger": {
      "model": "grok-4.7-high",
      "purpose": "Perform a bounded independent pre-mortem of a decision-ready plan before implementation.",
      "allowed_responsibility": [
        "challenge requirement interpretation and evidence coverage",
        "identify realistic high-risk failure modes and cross-checkpoint seams",
        "request the smallest material plan correction"
      ],
      "forbidden_responsibility": [
        "edit code, tests, planning documents, or workflow state",
        "replace established architecture with preferences",
        "request optional refactoring or general hardening",
        "start another challenger or review loop"
      ]
    },
    "external-review-triager": {
      "model": "grok-4.7-high",
      "purpose": "Independently classify GitHub Codex findings against the current pull-request head and authoritative package evidence.",
      "allowed_responsibility": [
        "verify all external findings against the current PR head and diff",
        "classify materiality and current-head relevance",
        "produce one minimal bundled external rework order for confirmed blockers"
      ],
      "forbidden_responsibility": [
        "edit source, tests, evidence, or workflow state",
        "accept external findings as truth without verification",
        "request Codex source-code changes",
        "commit, push, comment, review, or merge"
      ]
    }
  },
  "routing": {
    "coordinator_model": "composer-2.5",
    "normal_final_audit_host": "cursor-grok",
    "critical_final_audit_host": "external-codex",
